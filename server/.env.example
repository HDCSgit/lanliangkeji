# ============================================================
# 蓝粮海洋 B2B - 后端环境变量示例
# ============================================================
# 部署时复制为 .env 并填入真实值:
#   cp .env.example .env  &&  vim .env
# .env 已加入 .gitignore, 不会被提交到 Git
# ============================================================

# ===== 数据库 =====
# 开发用 SQLite (无需任何安装)
DATABASE_URL=sqlite:///./lanliang_dev.db
# 生产用 PostgreSQL (推荐)
# DATABASE_URL=postgresql://lanliang:STRONG_PASSWORD@127.0.0.1:5432/lanliang

# ===== JWT =====
# 生产环境必须改成随机长字符串 (可以用 openssl rand -hex 32 生成)
SECRET_KEY=CHANGE_ME_to_a_random_long_string_in_production
REFRESH_SECRET_KEY=CHANGE_ME_to_another_random_long_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS =====
# 多个域名用英文逗号分隔, 部署到生产后改成实际域名
CORS_ORIGINS=https://lanliangkeji.cn,https://www.lanliangkeji.cn

# ===== 文件上传 =====
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# ===== 初始系统管理员 =====
# 首次部署后, 用 sysadmin/sysadmin123 登录管理后台, 立即改密码!
SYSADMIN_PHONE=sysadmin
SYSADMIN_PASSWORD=CHANGE_ME_to_strong_password_on_first_login
SYSADMIN_NAME=系统管理者

# ===== 服务监听 =====
# 用 Nginx 反向代理时, 只监听本地 (127.0.0.1)
HOST=127.0.0.1
PORT=8000

# ============================================================
# 支付宝开放平台
# 申请地址: https://open.alipay.com/develop/pm/sub/setting
# 注意: 私钥/公钥必须从支付宝开放平台获取, 不要用任何 demo 值
# ============================================================

# 你的应用 AppID (个人开发者 AppID 也是 OK 的)
ALIPAY_APP_ID=YOUR_ALIPAY_APP_ID

# 应用私钥 (RSA2, 完整 PEM 格式, 头尾 -----BEGIN/-----END 不能漏)
ALIPAY_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
YOUR_PRIVATE_KEY_BASE64_CONTENT_LINE_1
YOUR_PRIVATE_KEY_BASE64_CONTENT_LINE_2
...
-----END RSA PRIVATE KEY-----"

# 支付宝公钥 (从开放平台"应用 -> 查看应用公钥"那块的"支付宝公钥"获取, 不是应用公钥)
ALIPAY_ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
YOUR_ALIPAY_PUBLIC_KEY_BASE64_CONTENT_LINE_1
YOUR_ALIPAY_PUBLIC_KEY_BASE64_CONTENT_LINE_2
...
-----END PUBLIC KEY-----"

# 正式网关 (用沙箱 AppID 时改成 https://openapi.alipaydev.com/gateway.do)
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 异步通知 (支付宝 -> 服务器, POST)
# 必须是 https + 公网可访问 (必须先去开放平台"应用配置 -> 授权回调地址"配)
ALIPAY_NOTIFY_URL=https://lanliangkeji.cn/api/v1/payments/alipay/notify

# 同步跳转 (用户支付完成后浏览器回跳, GET)
# 后端会渲染 "等待页" 然后 3 秒跳到 ALIPAY_RETURN_URL (前端绝对 URL + #/order/{id})
ALIPAY_RETURN_URL=https://lanliangkeji.cn/api/v1/payments/alipay/return

# 前端基础 URL (供同步跳转后端页 3 秒后跳转前端订单详情用)
# HashRouter: 路径直接 /#/order/{id} 会被解析为前端 hash 路由
FRONTEND_BASE_URL=https://lanliangkeji.cn
