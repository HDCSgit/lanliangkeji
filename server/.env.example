DATABASE_URL=postgresql://lanliang:lanliang123@localhost:5432/lanliang
SECRET_KEY=your-super-secret-key-change-in-production
REFRESH_SECRET_KEY=your-refresh-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# File upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# Initial sysadmin
SYSADMIN_PHONE=sysadmin
SYSADMIN_PASSWORD=sysadmin123
SYSADMIN_NAME=系统管理者

# Server
HOST=0.0.0.0
PORT=8000

# ============================================================
# 支付宝开放平台(电脑网站支付 / 手机网站支付)
# 申请地址: https://open.alipay.com/develop/pm/sub/setting
# 沙箱环境改用 ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do
# ============================================================
ALIPAY_APP_ID=2021005100624633
ALIPAY_APP_PRIVATE_
ALIPAY_ALIPAY_PUBLIC_
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 异步通知:支付宝 -> 你的服务器 (POST)
# 必须外网可访问,正式环境用 https://lanliangkeji.cn/api/v1/payments/alipay/notify
ALIPAY_NOTIFY_URL=https://lanliangkeji.cn/api/v1/payments/alipay/notify
# 同步跳转:用户支付成功后浏览器跳回 (GET)
# 一般跳到订单详情页
ALIPAY_RETURN_URL=https://lanliangkeji.cn/orders

